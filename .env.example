# Copy to .env and replace placeholders. Do not commit .env.
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
TENANT_API_KEYS={"replace-with-a-random-api-key":"tenant-a"}
DATABASE_PATH=data/gateway.sqlite3
MCP_DOWNSTREAM_URL=http://127.0.0.1:9001/mcp
PRIMARY_URL=http://127.0.0.1:9001/primary/generate
BACKUP_URL=http://127.0.0.1:9001/backup/generate
# Optional independent upstream service credentials:
MCP_DOWNSTREAM_TOKEN=
PROVIDER_TOKEN=
